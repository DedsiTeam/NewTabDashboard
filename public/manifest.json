{
  "manifest_version": 3,
  "name": "DedsiNewTab",
  "version": "0.1.0",
  "description": "本地存储的分组式新标签页，支持横向分组与快捷入口。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "favicon"],
  "optional_permissions": ["bookmarks"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
